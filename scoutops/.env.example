NODE_ENV=development
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_NAME=scoutops
DB_USER=scoutops_user
DB_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Optional monitoring / deployment variables
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SCOUTOPS_IMAGE_REPOSITORY=
SCOUTOPS_IMAGE_TAG=
TLS_CERT_DIR=
TLS_HOSTNAME=
TRUST_PROXY=false

# AWS deployment / EC2 hardening variables
AWS_REGION=us-east-1
AWS_INSTANCE_ID=

# Do not commit the real .env file. Keep environment secrets out of version control.
